<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FHorizon" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fh_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.FHorizon.Fullscreen" parent="Theme.FHorizon">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="Theme.FHorizon.Game" parent="android:Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
